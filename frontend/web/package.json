{
  "name": "strata-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive demo of STRATA, driven by the real C++ table through frontend/engine.",
  "scripts": {
    "engine": "node scripts/build-engine.mjs",
    "results": "node scripts/make-results.mjs",
    "dev": "node scripts/build-engine.mjs && vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/build-engine.mjs && vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "test": "node scripts/build-engine.mjs && node --test tests/engine.test.mjs tests/code.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
